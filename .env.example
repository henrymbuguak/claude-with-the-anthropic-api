# Copy this file to .env and fill in your own values.
# Never commit your real .env file - it is already excluded via .gitignore.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: model to use for chat completions
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: max tokens generated per response
ANTHROPIC_MAX_TOKENS=500

# Optional: sampling temperature (0.0 - 1.0)
ANTHROPIC_TEMPERATURE=1.0

# Optional: let Claude use Anthropic's server-side web search for current information.
# Web searches may incur additional Anthropic charges. Claude decides when to search.
ANTHROPIC_WEB_SEARCH_ENABLED=false
# Maximum searches Claude may perform in one API request.
ANTHROPIC_WEB_SEARCH_MAX_USES=3
# Optional comma-separated allowlist. Leave empty to search all available domains.
ANTHROPIC_WEB_SEARCH_ALLOWED_DOMAINS=

# Optional: system prompt applied to every conversation.
# Prefer a versioned prompt file (tracked in prompts/, diffable, usable with
# the eval harness in eval/run_eval.py) over an inline string.
ANTHROPIC_SYSTEM_PROMPT_FILE=prompts/scientist_v1.txt
# Alternative: inline system prompt (used only if ANTHROPIC_SYSTEM_PROMPT_FILE is unset)
# ANTHROPIC_SYSTEM_PROMPT="You are a helpful assistant."

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: where conversation history is saved/resumed from
CONVERSATION_HISTORY_FILE=conversation_history.json